[Unit]
Description=svar-wave audio upload & playback service
After=network.target sound.target

[Service]
Type=simple
User=sb
# WorkingDirectory matters: config paths like ./uploads are relative to it
WorkingDirectory=/opt/svar-wave
ExecStart=/usr/local/bin/svar-wave -config /etc/svar-wave/config.yaml
Restart=on-failure
RestartSec=3

# Optional hardening
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/svar-wave /var/lib/svar-wave

[Install]
WantedBy=multi-user.target
